# ========================================
# ⚙️ General Settings
# ========================================
# Set to 'true' to enable test webhooks and debugging tools
NEXT_PUBLIC_DEBUG_MODE=false
# Set to 'true' to allow users to apply for staff
NEXT_PUBLIC_APPLICATIONS_OPEN="false"

# ========================================
# 🔐 Auth (NextAuth & Discord)
# ========================================
# The base URL of your application
NEXTAUTH_URL=https://meermc.vercel.app
# Generate a secret using: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# Discord OAuth Application credentials (From Developer Portal)
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_PUBLIC_KEY=your_discord_public_key
DISCORD_TOKEN=your_discord_bot_token

# ========================================
# 🔧 Minecraft Plugin API (CoreSuite)
# ========================================
# Connection to the CoreSuite internal web server
PLUGIN_API_HOST=your_game_server_ip
PLUGIN_API_PORT=25580
PLUGIN_API_KEY=your_secret_api_key_here

# ========================================
# 🤖 Discord Webhooks & Role IDs (Optional)
# ========================================
# Channel/Role IDs
DISCORD_ADMIN_CHANNEL_ID=your_admin_channel_id
NEXT_PUBLIC_DISCORD_PING_ROLE=your_discord_ping_role_id

# Webhooks for notifications
DISCORD_APPLY_WEBHOOK=https://discord.com/api/webhooks/...

# ---------------------------------------------------------
# Dynamic Top Voters Configuration (Optional)
# ---------------------------------------------------------
# Option A: MySQL Database (Recommended - supports all sites like VotingPlugin)
VOTE_DB_HOST=
VOTE_DB_USER=
VOTE_DB_PASS=
VOTE_DB_NAME=
VOTE_DB_TABLE=VotingPlugin_Users

# Option B: Minecraft-MP API Fallback (Only tracks votes from Minecraft-MP)
MINECRAFT_MP_API_KEY=your_server_api_key

# ---------------------------------------------------------
# Note: Variables like Prices, IPs, and Social Links are 
# automatically fetched from your Minecraft server's website.yml 
# using the sync-env script during deployment!
# ---------------------------------------------------------
